{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "check:api-codegen-drift": "node ./scripts/check-api-codegen-drift.mjs",
    "test:api-codegen-drift": "node --test ./scripts/check-api-codegen-drift.test.mjs",
    "test:post-merge-backlog-indexes": "node --test ./scripts/post-merge-backlog-indexes.test.mjs",
    "test:post-merge-schema-push": "node --test ./scripts/post-merge-schema-push.test.mjs",
    "check:api-typecheck-rebuilds-db": "node ./scripts/check-api-typecheck-rebuilds-db.mjs",
    "check:api-typecheck-rebuilds-libs:failure": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --expect-validation-failure",
    "check:api-typecheck-rebuilds-libs:concurrency": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-concurrent-runs",
    "check:api-typecheck-rebuilds-libs:interruption": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-interrupted-recovery",
    "check:api-typecheck-rebuilds-libs:interrupted-publication": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-interrupted-publication",
    "check:api-typecheck-rebuilds-libs:lock-handoff": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-recovery-lock-handoff",
    "check:api-typecheck-rebuilds-libs:lock-cleanup": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-recovery-lock-cleanup",
    "check:api-typecheck-rebuilds-libs:lock-rescan-failure": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-recovery-lock-rescan-failure",
    "check:api-typecheck-rebuilds-libs:lock-multi-rescan-failure": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-recovery-lock-multi-rescan-failure",
    "check:api-typecheck-rebuilds-libs:recovery": "pnpm run check:api-typecheck-rebuilds-libs:interruption && pnpm run check:api-typecheck-rebuilds-libs:lock-handoff && pnpm run check:api-typecheck-rebuilds-libs:lock-cleanup && pnpm run check:api-typecheck-rebuilds-libs:lock-rescan-failure && pnpm run check:api-typecheck-rebuilds-libs:lock-multi-rescan-failure",
    "check:api-typecheck-rebuilds-libs:process-identity": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-process-identity",
    "check:api-typecheck-rebuilds-libs:race-diagnostics": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-replacement-owner-race-diagnostics",
    "check:api-typecheck-rebuilds-libs:process-identity:native": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-native-process-identity",
    "check:api-typecheck-rebuilds-libs:process-identity:native-transition-exit": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-native-transition-lock-owner-exit",
    "check:api-typecheck-rebuilds-libs:process-identity:native-timeout": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-native-process-identity-timeout",
    "check:api-typecheck-rebuilds-libs:process-identity:native-descendant-lifecycle": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-native-process-identity-descendant-lifecycle",
    "check:api-typecheck-rebuilds-libs:process-identity:recovery": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-native-process-identity-recovery",
    "check:api-typecheck-rebuilds-libs:process-identity:recovery-diagnostics": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-native-recovery-diagnostic-atomicity",
    "check:api-typecheck-rebuilds-libs:unsafe-recovery": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-unsafe-recovery-manifests",
    "check:api-typecheck-rebuilds-libs:owner-age": "node ./scripts/check-api-typecheck-rebuilds-db.mjs --test-recovery-owner-age",
    "check:api-typecheck-rebuilds-libs": "node ./scripts/check-api-typecheck-rebuilds-db.mjs",
    "check:frontend-typecheck-refreshes-api-client": "node ./scripts/check-frontend-typecheck-refreshes-api-client.mjs",
    "test:frontend-typecheck-refreshes-api-client": "node --test ./scripts/check-frontend-typecheck-refreshes-api-client.test.mjs",
    "test:frontend-typecheck-refresh-cleanup": "node --test ./scripts/frontend-typecheck-refresh-cleanup.test.mjs",
    "check:required-merge-checks": "node ./scripts/check-required-merge-checks.mjs",
    "check:node-support-matrix": "node ./scripts/check-node-support-matrix.mjs",
    "test:node-support-matrix": "node --test ./scripts/check-node-support-matrix.test.mjs",
    "generate:clickhouse-release-policy": "node ./scripts/clickhouse-release-policy.mjs",
    "check:clickhouse-release-policy": "node ./scripts/clickhouse-release-policy.mjs --check",
    "test:required-merge-checks": "node --test ./scripts/check-required-merge-checks.test.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
