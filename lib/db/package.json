{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "node ./scripts/normalize-subscriber-emails.mjs && node ./scripts/prepare-review-search.mjs && node ./scripts/push-schema.mjs && node ./scripts/migrate-submission-publication.mjs && node ./scripts/install-upload-cleanup.mjs",
    "push-force": "node ./scripts/normalize-subscriber-emails.mjs && node ./scripts/prepare-review-search.mjs && drizzle-kit push --force --config ./drizzle.config.ts && node ./scripts/migrate-submission-publication.mjs && node ./scripts/install-upload-cleanup.mjs",
    "test:review-search-plans": "node ./scripts/benchmark-review-queue.mjs",
    "migrate:upload-cleanup": "node ./scripts/install-upload-cleanup.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
